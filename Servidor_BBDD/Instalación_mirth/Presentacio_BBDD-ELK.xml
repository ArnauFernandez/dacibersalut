            <script>try {
    var patId = channelMap.get(&apos;oh_patient_pat_id&apos;);
    var patName = channelMap.get(&apos;oh_patient_pat_name&apos;);
    var patSex = channelMap.get(&apos;oh_patient_pat_sex&apos;);
    var patBdate = channelMap.get(&apos;oh_patient_pat_bdate&apos;);
    var patAge = parseInt(channelMap.get(&apos;oh_patient_pat_age&apos;), 10);
    
    var bulkPayload = &apos;&apos;;

    // Metadata for bulk indexing
    bulkPayload += JSON.stringify({
        &quot;index&quot;: {
            &quot;_index&quot;: &quot;patients_index&quot;,
            &quot;_id&quot;: patId
        }
    }) + &apos;\n&apos;;

    // Patient document
    bulkPayload += JSON.stringify({
        &quot;pat_id&quot;: patId,
        &quot;pat_name&quot;: patName,
        &quot;pat_sex&quot;: patSex,
        &quot;pat_age&quot;: parseInt(patAge),
        &quot;pat_age2&quot;: parseInt(patAge),
        &quot;pat_bdate&quot;: parseDatetime(patBdate),
        &quot;pat_bdate2&quot;: parseDatetime(patBdate),
        &quot;timestamp&quot;: new Date().toISOString()
    }) + &apos;\n&apos;;

    channelMap.put(&apos;elasticPayload&apos;, bulkPayload);
    logger.info(&apos;Prepared single-record payload for patient ID: &apos; + patId);
    tmp=$(&apos;elasticPayload&apos;);
    return bulkPayload;

} catch (e) {
    logger.error(&apos;Error creating Elasticsearch payload: &apos; + e);
    throw e;
}

function parseDatetime(value) {
	var result = &quot;&quot;;
	try {
		result = DateUtil.convertDate(&quot;yyyyMMdd&quot;, &quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSSXXX&quot;, value);
	} catch (e) {}
	return result;
}</script>
